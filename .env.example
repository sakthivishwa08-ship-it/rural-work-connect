# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Map Provider API key (Google Maps or OpenStreetMap/Mapbox)
# When omitted, the app automatically uses the built-in Indian location directory and manual GPS fallback
VITE_MAPS_API_KEY=

# Platform branding
VITE_APP_NAME="Rural Work Connect"
